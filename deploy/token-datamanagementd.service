[Unit]
Description=token Data Management Daemon
After=network.target
Wants=network.target

[Service]
Type=simple
User=token
Group=token
WorkingDirectory=/opt/token
ExecStart=/opt/token/datamanagementd \
  -socket-path /tmp/token-datamanagement.sock \
  -sqlite-path /var/lib/token/datamanagement/datamanagementd.db \
  -version 1.0.0
Restart=always
RestartSec=5s
LimitNOFILE=100000
NoNewPrivileges=true
PrivateTmp=false

[Install]
WantedBy=multi-user.target
