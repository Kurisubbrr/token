# 在 Linux 服务器解压目录执行 ./init-env.sh 后，会生成独立的 .env。
# 下列占位符不能直接用于部署，不应复制本地开发配置。
COMPOSE_PROJECT_NAME=token-custom
IMAGE_TAG=local
BIND_HOST=127.0.0.1
SERVER_PORT=8080
TZ=Asia/Shanghai
RUN_MODE=standard

POSTGRES_USER=token
POSTGRES_DB=token
POSTGRES_PASSWORD=__GENERATE_POSTGRES_PASSWORD__
REDIS_PASSWORD=__GENERATE_REDIS_PASSWORD__
JWT_SECRET=__GENERATE_JWT_SECRET__
TOTP_ENCRYPTION_KEY=__GENERATE_TOTP_ENCRYPTION_KEY__
ADMIN_EMAIL=__GENERATE_ADMIN_EMAIL__
ADMIN_PASSWORD=__GENERATE_ADMIN_PASSWORD__

SECURITY_URL_ALLOWLIST_ENABLED=false
SECURITY_URL_ALLOWLIST_ALLOW_INSECURE_HTTP=false
SECURITY_URL_ALLOWLIST_ALLOW_PRIVATE_HOSTS=false
UPDATE_PROXY_URL=
GEMINI_OAUTH_CLIENT_ID=
GEMINI_OAUTH_CLIENT_SECRET=
GEMINI_CLI_OAUTH_CLIENT_ID=
GEMINI_CLI_OAUTH_CLIENT_SECRET=
ANTIGRAVITY_OAUTH_CLIENT_ID=
ANTIGRAVITY_OAUTH_CLIENT_SECRET=
